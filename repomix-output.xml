@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
  html {
    @apply font-sans;
  }
}

/* ==========================================
   Custom Utilities & Animations
   ========================================== */

/* Glass Panel Effect */
.glass-panel {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: #c7c4d8;
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: #777587;
}

/* Material Symbols support */
.material-symbols-outlined {
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

/* Gradient accent on hover for cards */
.card-hover-accent {
  position: relative;
  overflow: hidden;
}
.card-hover-accent::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(to right, #4f46e5, #7c3aed);
  opacity: 0;
  transition: opacity 0.3s ease;
}
.card-hover-accent:hover::before {
  opacity: 1;
}

/* ATS Scan Animation */
@keyframes ats-scan {
  0%,
  100% {
    transform: translateY(-100%);
    opacity: 0;
  }
  50% {
    transform: translateY(100%);
    opacity: 1;
  }
}

.animate-ats-scan {
  animation: ats-scan 3s ease-in-out infinite;
}

/* Pulse glow for AI processing */
@keyframes pulse-glow {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.4);
  }
  50% {
    box-shadow: 0 0 20px 5px rgba(79, 70, 229, 0.2);
  }
}

.animate-pulse-glow {
  animation: pulse-glow 2s ease-in-out infinite;
}
