        {/* Experience */}
        {experience && experience.length > 0 && (
          <div style={{ marginBottom: "20px" }}>
            <h2
              style={{
                fontSize: "13px",
                fontWeight: "bold",
                textTransform: "uppercase",
                borderBottom: "1px solid #000",
                paddingBottom: "4px",
