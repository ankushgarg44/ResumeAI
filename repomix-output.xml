                    {(trn.startDate || trn.endDate) && (
                      <div style={{ color: "#666", marginTop: "2px", marginBottom: "4px" }}>
                        {trn.startDate && formatDate(trn.startDate)} {trn.endDate && `– ${formatDate(trn.endDate)}`}
