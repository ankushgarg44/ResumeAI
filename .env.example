# ResumeAI — Environment Variables Example
# Duplicate this file to .env.local and populate with your credentials.

# -----------------------------------------------------------------------------
# Clerk Authentication
# Sign up at https://clerk.com to obtain these keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key-here
CLERK_SECRET_KEY=your-clerk-secret-key-here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# OpenAI API
# Sign up at https://platform.openai.com to obtain your API key
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
